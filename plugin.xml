<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

   <extension
         id="application"
         point="org.eclipse.core.runtime.applications">
      <application>
         <run
               class="com.xmos.xtagui.Application">
         </run>
      </application>
   </extension>
   <extension
         point="org.eclipse.ui.perspectives">
      <perspective
            name="Xta Perspective"
            class="com.xmos.xtagui.Perspective"
            id="com.xmos.xtagui.Perspective">
      </perspective>
   </extension>
   <extension
         point="org.eclipse.ui.editors">
      <editor
            class="com.xmos.xtagui.editors.Sources"
            default="false"
            id="com.xmos.xtagui.editors.Sources"
            name="Sources">
      </editor>
   </extension>
   <extension
         point="org.eclipse.ui.views">
      <view
            class="com.xmos.xtagui.views.Tree"
            id="com.xmos.xtagui.views.Tree"
            name="Tree"
            restorable="true">
      </view>
      <view
            class="com.xmos.xtagui.views.Loop"
            id="com.xmos.xtagui.views.Loop"
            name="Loop"
            restorable="true">
      </view>
      <view
            class="com.xmos.xtagui.views.Disassembly"
            id="com.xmos.xtagui.views.Disassembly"
            name="Disassembly"
            restorable="true">
      </view>
      <view
            class="com.xmos.xtagui.views.Console"
            id="com.xmos.xtagui.views.Console"
            name="Console"
            restorable="true">
      </view>
      <view
            class="com.xmos.xtagui.views.Errors"
            id="com.xmos.xtagui.views.Errors"
            name="Errors"
            restorable="true">
      </view>
      <view
            class="com.xmos.xtagui.views.Function"
            id="com.xmos.xtagui.views.Function"
            name="Function"
            restorable="true">
      </view>
      <view
            class="com.xmos.xtagui.views.Flow"
            id="com.xmos.xtagui.views.Flow"
            name="Flow"
            restorable="true">
      </view>
      <view
            class="com.xmos.xtagui.views.Structure"
            id="com.xmos.xtagui.views.Structure"
            name="Structure"
            restorable="true">
      </view>
   </extension>
   <extension
         point="org.eclipse.ui.commands">
      <command
            defaultHandler="com.xmos.xtagui.handlers.ExitHandler"
            id="com.xmos.xtagui.exit.command"
            name="com.xmos.xtagui.exit.command">
      </command>
      <command
            defaultHandler="com.xmos.xtagui.handlers.OpenHandler"
            id="com.xmos.xtagui.open.command"
            name="com.xmos.xtagui.open.command">
      </command>
   </extension>
   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="menu:org.eclipse.ui.main.menu">
         <menu
               label="File">
            <command
                  commandId="com.xmos.xtagui.open.command"
                  label="Open"
                  style="push">
            </command>
            <command
                  commandId="com.xmos.xtagui.exit.command"
                  label="Exit"
                  style="push">
            </command>
         </menu>
      </menuContribution>
   </extension>

</plugin>
