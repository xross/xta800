analyse path right3 right4
set required - 620 ns
analyse path right4 left1
set required - 620 ns
analyse path left1 left2
set required - 620 ns
analyse path left2 left3
set required - 620 ns
analyse path left3 left4
set required - 620 ns
analyse path left4 right1
set required - 620 ns

analyse path right1 right3
set required - 1260 ns
analyse path right2 right4
set required - 1260 ns
analyse path right3 left1
set required - 1260 ns
analyse path right4 left2
set required - 1260 ns
analyse path left1 left3
set required - 1260 ns
analyse path left2 left4
set required - 1260 ns
analyse path left3 right1
set required - 1260 ns
analyse path left4 right2
