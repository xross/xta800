Modifiable Enabled    Reference  ->     MapsTo
true       true       foo.xc:15  ->    label_\d+
true       true       .+/bar.xc:11 ->    label_\d+
true       true       .+/bar.xc:6 ->    label_\d+
true       true       .+/bar.xc:9 ->    label_\d+
Modifiable Enabled    Reference  ->     MapsTo
true       true       foo.xc:15  ->          x
true       true       .+/bar.xc:11 -> out_of_bounds
true       true       .+/bar.xc:6 ->      start
true       true       .+/bar.xc:9 ->       stop
load ".+test.xe"

#
# Route: foo.xc:15 => .+/foo.xc:15
#
add exclusion out_of_bounds
analyse path x x

#
# Route: .+/bar.xc:6 => .+/bar.xc:9
#
analyse path start stop

#
# Route: bar.xc:6 => bar.xc:6
#
analyse path start start

