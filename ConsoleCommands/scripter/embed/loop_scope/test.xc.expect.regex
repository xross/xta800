void f\(\) {
    int res = 0;

    for \(int i = 0; i < 10; \+\+i\) {
        #pragma xta label "outer"
        for \(int j = 0; j < 3; \+\+j\) {
            #pragma xta label "inner"
            res \+= j;
        }
        res \+= i;
    }

    for \(int i = 0; i < 10; \+\+i\) {
        #pragma xta label "loop_iterations_0"
        for \(int j = 0; j < 3; \+\+j\) {
            #pragma xta label "loop_iterations_1"
            res \+= j;
        }
        res \+= i;
    }
}

void g\(\) {
    #pragma xta call "f1" 
    f\(\);
    #pragma xta call "f2" 
    f\(\);
}
    
int main\(\) {
    #pragma xta call "call_0"
    g\(\);
    return 0;
}



//
// Route: main
//
#pragma xta command "analyze function main"
#pragma xta command "set loop - f1,outer 10"
#pragma xta command "set loop - f1,inner 20"
#pragma xta command "set loopscope - f1,inner a"
#pragma xta command "set loop - call_0,f1,loop_iterations_0 30"
#pragma xta command "set loop - call_0,f1,loop_iterations_1 40"
#pragma xta command "set loopscope - call_0,f1,loop_iterations_1 a"
#pragma xta command "set loop - f2,outer 50"
#pragma xta command "set loop - f2,inner 60"
#pragma xta command "set loopscope - f2,inner a"
#pragma xta command "set loop - call_0,f2,loop_iterations_0 70"
#pragma xta command "set loop - call_0,f2,loop_iterations_1 80"
#pragma xta command "set loopscope - call_0,f2,loop_iterations_1 a"
#pragma xta command "set required - 1.0 us"

