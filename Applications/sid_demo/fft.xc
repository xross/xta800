/* FFT Based on code by Tom Roberts 11/8/89, Malcolm Slaney 12/15/94 */

#include <xs1.h>
#include <xclib.h>

extern int Sinewave[]; /* under the fft */

void fix_fft_512(short fin[], unsigned int fout[]) {
    int fr[512], fi[512];
    int l,k;
    int sum = 0;

#pragma unsafe arrays
    for(int m=0; m<512; m++) {
        sum += fin[m] >> 9;
        fi[m] = 0;
        fr[bitrev(m<<23)] = fin[m];
    }
#pragma unsafe arrays
    for(int m=0; m<512; m++) {
        fr[m] -= sum;
    }

    l = 1;
    k = 8;
#pragma unsafe arrays
    while(l < 512) {
        for(int m=0; m < l; m++) {
            int j = m << k;
            int wr =  Sinewave[j+128];
            int wi = -Sinewave[j];
            wr >>= 1;
            wi >>= 1;
            for(int i=m; i< 512; i+=l+l) {
                int j = i + l;
                int tr = (wr*fr[j] - wi*fi[j])>>15;
                int ti = (wr*fi[j] + wi*fr[j])>>15;
                int qr = fr[i];
                int qi = fi[i];
                qr >>= 1;
                qi >>= 1;
                fr[j] = qr - tr;
                fi[j] = qi - ti;
                fr[i] = qr + tr;
                fi[i] = qi + ti;
            }
        }
        k-=1;
        l = l << 1;
    }
    for(int m=0; m<512; m += 1) {
        fout[m] = fr[m] * fr[m] + fi[m] * fi[m];
    }
}

