  14: #include <xs1.h>
  15: #include <platform.h>
  16: 
  17: on stdcore[0] : out port p_led0 = XS1_PORT_1F;
  18: on stdcore[1] : out port p_led1 = XS1_PORT_1F;
  19: on stdcore[2] : out port p_led2 = XS1_PORT_1F;
  20: on stdcore[3] : out port p_led3 = XS1_PORT_1F;
  21: on stdcore[0] : in port p_button = XS1_PORT_4F;
  22: 
  23: void led1_thread(out port p_led, chanend prev, chanend next, int start);
  24: void led2_thread(out port p_led, chanend prev, chanend next, int start);
  25: void button_listener(in port p_button, chanend prev, chanend next);
  26: void printout();
  27: 
  28: int main()
  29: {
  30:   chan c_0to1;
  31:   chan c_1to2;
  32:   chan c_2to3;
  33:   chan c_3to0;
  34:   chan button_chan;
  35: 
  36:   par
  37:   {
  38:     on stdcore[0] : led1_thread(p_led0, c_0to1, c_1to2, 1);
  39:     on stdcore[1] : led2_thread(p_led1, c_1to2, c_2to3, 0);
  40:     on stdcore[2] : led1_thread(p_led2, c_2to3, c_3to0, 0);
  41:     on stdcore[3] : led2_thread(p_led3, c_3to0, button_chan, 0);
  42:     on stdcore[0] : button_listener(p_button, button_chan, c_0to1);
  43:   }
  44: 
  45:   return 0;
  46: }
  47: 
  48: #define PERIOD 10000000
  49: 
  50: void flashled(out port p_led)
+ 51: {
  52:    #pragma xta label "flashled_label"
  53:    unsigned s;
  54:    timer tmr;
+ 55:    p_led <: 0;
+ 56:    tmr :> s;
+ 57:    tmr when timerafter(s + PERIOD) :> s ;
+ 58:    p_led <: 1;
+ 59:    return;
  60: }
  61: 
  62: void button_listener(in port p_button, chanend prev, chanend next)
  63: {
  64:    #pragma xta label "button_label"
  65:    int button_press;
  66:    int token = 1;
  67:    printout();
  68:    while (token) {
  69:       prev:> token;
  70:       p_button :> button_press;
  71:       if (token){
  72:          if( ((~button_press)&0xf) == 0x4 ){
  73:            next <: 0;
  74:          } else {
  75:            next <: 1;
  76:          }
  77:       }
  78:   }
  79:   return;
  80: }
  81: 
  82: void led1_thread(out port p_led, chanend prev, chanend next, int start)
  83: {
  84:    int token = 1;
  85:    if (start) next <: 1;
  86:    #pragma xta label "led1_thread_label"
  87:    while (token) {
  88:       prev :> token;
  89:       flashled(p_led);
  90:       next <: token;
  91:   }
  92:   return;
  93: }
