load ".*test\.xe"

#
# Route: x => x
#
add exclusion the_great_outdoors
analyze path x x
# Warning: '0x[0-9a-fA-F]{5}' is a non-portable reference.
set loop 0 0x[0-9a-fA-F]{5} 10
# Warning: '0x[0-9a-fA-F]{5}' is a non-portable reference.
set loop 1 0x[0-9a-fA-F]{5} 20
# Warning: '0x[0-9a-fA-F]{5}' is a non-portable reference.
set loop 2 0x[0-9a-fA-F]{5} 30
# Warning: '0x[0-9a-fA-F]{5}' is a non-portable reference.
set loop 3 0x[0-9a-fA-F]{5} 40

