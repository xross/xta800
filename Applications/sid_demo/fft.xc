#define SHIFT 64
#define BUFSIZE 512

void ffter(short fromBuf[], unsigned int outBuf[]) {
    short fi[512];
    unsigned int fo[512];
    int cnt = 0;

#pragma unsafe arrays
        int avg;

        avg = 0;
        for(int i=0; i < 512-SHIFT; i++) {
            fi[i] = fi[i+SHIFT];
        }

        for(int i=512-SHIFT; i<512; i++) {
            fi[i] = (int)fromBuf[cnt++];
        }

        fix_fft_512(fi,fo);

    	avg = 0;
    	cnt = 0;
    	for(int i=1; i<=12; i++)
    	{
    		for(int j=0; j<20; j++)
    			avg += (int)(fo[i*19+j] + fo[511-(i*19+j)]);
    		avg >>= 12;

    		if(avg>255)
    			avg = 255;
    		
    		outBuf[cnt++] = (unsigned int)avg;
    	}
}

