<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

   <extension
         id="application"
         point="org.eclipse.core.runtime.applications">
      <application>
         <run
               class="com.xmos.xta.ui.Application">
         </run>
      </application>
   </extension>
   <extension
         point="org.eclipse.ui.perspectives">
      <perspective
            class="com.xmos.xta.ui.XtaPerspective"
            icon="icons/xta16x16.png"
            id="com.xmos.xta.ui.XtaPerspective"
            name="Xta">
      </perspective>
   </extension>
   <extension
         point="org.eclipse.ui.editors">
      <editor
            class="com.xmos.xta.ui.editors.script.ScriptEditor"
            default="false"
            icon="icons/xta16x16.png"
            id="com.xmos.xta.ui.editors.script.ScriptEditor"
            name="ScriptEditor">
      </editor>
      <editor
            class="com.xmos.xta.ui.editors.source.XtaSourceEditor"
            default="false"
            icon="icons/xta16x16.png"
            id="com.xmos.xta.ui.editors.XtaSourceEditor"
            name="XtaSourceEditor">
      </editor>
      <editor
            class="com.xmos.xta.ui.editors.XtaEditor"
            default="false"
            id="com.xmos.xta.ui.editors.XtaEditor"
            name="XtaEditor">
      </editor>
   </extension>
   <extension
         point="org.eclipse.ui.views">
      <view
            class="com.xmos.xta.ui.views.routes.RoutesView"
            icon="icons/tree.png"
            id="com.xmos.xta.ui.views.routes.Routes"
            name="Routes"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.ui.views.console.ConsoleView"
            icon="icons/console.png"
            id="com.xmos.xta.ui.views.console.Console"
            name="Console"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.ui.views.info.InfoView"
            icon="icons/unknowns.png"
            id="com.xmos.xta.ui.views.info.Info"
            name="Info"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.ui.views.visualisations.VisualisationsView"
            icon="icons/visualisations.png"
            id="com.xmos.xta.ui.views.visualisations.Visualisations"
            name="Visualisations"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.ui.views.binary.BinaryView"
            icon="icons/open_disassembly.png"
            id="com.xmos.xta.ui.views.binary.Binary"
            name="Binary"
            restorable="true">
      </view>
   </extension>
  
   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="toolbar:com.xmos.xta.ui.views.visualisations.Visualisations">
         <command
               commandId="com.xmos.xta.ui.zoomin.command"
               icon="icons/zoomin.png"
               id="com.xmos.xta.ui.zoomin.command"
               label="Zoom In"
               style="push">
         </command>
         <command
               commandId="com.xmos.xta.ui.zoomout.command"
               icon="icons/zoomout.png"
               id="com.xmos.xta.ui.zoomout.command"
               label="Zoom Out"
               style="push">
         </command>
         <command
               commandId="com.xmos.xta.ui.zoomreset.command"
               icon="icons/zoomreset.png"
               id="com.xmos.xta.ui.zoomreset.command"
               label="Reset Zoom"
               style="push">
         </command>
         <command
               commandId="com.xmos.xta.ui.zoomfit.command"
               icon="icons/zoomfit.png"
               id="com.xmos.xta.ui.zoomfit.command"
               label="Zoom to fit"
               style="push">
         </command>
         <command
               commandId="com.xmos.xta.ui.exportjpg.command"
               icon="icons/filesave.png"
               id="com.xmos.xta.ui.exportjpg.command"
               label="Export as jpg"
               style="push">
         </command>
      </menuContribution>
   </extension>
   <extension
         point="org.eclipse.ui.commands">
	<command
            defaultHandler="com.xmos.xta.ui.handlers.ZoomInHandler"
            id="com.xmos.xta.ui.zoomin.command"
            name="com.xmos.xta.ui.zoomin.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.ui.handlers.ZoomOutHandler"
            id="com.xmos.xta.ui.zoomout.command"
            name="com.xmos.xta.ui.zoomout.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.ui.handlers.ZoomResetHandler"
            id="com.xmos.xta.ui.zoomreset.command"
            name="com.xmos.xta.ui.zoomreset.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.ui.handlers.ZoomFitHandler"
            id="com.xmos.xta.ui.zoomfit.command"
            name="com.xmos.xta.ui.zoomfit.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.ui.handlers.ExportJpgHandler"
            id="com.xmos.xta.ui.exportjpg.command"
            name="com.xmos.xta.ui.exportjpg.command">
      </command>
   </extension>
