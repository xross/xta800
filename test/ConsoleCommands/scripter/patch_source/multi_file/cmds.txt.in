
add exclusion BAR:16
analyze path foo.xc:15 FOO:15

analyze path BAR:11 BAR:14
analyze path bar.xc:11 bar.xc:11

scripter listrefs
scripter rename foo.xc:15 x
scripter rename BAR:16 out_of_bounds
scripter rename BAR:11 start
scripter rename bar.xc:14 stop
scripter listrefs

scripter dump
exit
