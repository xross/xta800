<project name="tools_xta" default="dist" basedir=".">
  <property environment="env"/>

  <!-- set global properties for this build -->
  <property name="src" location="src"/>
  <property name="build" location="build"/>
  <property name="buildlib" location="build/lib"/>
  <property name="dist"  location="dist"/>
  
  <!-- Create the build directory structure used by compile -->
  <target name="init">
    <tstamp/>
    <mkdir dir="${build}"/>
    <mkdir dir="${build}"/>
    <mkdir dir="${buildlib}"/>
  </target>

  <!-- Compile the java code from ${src} into ${build} -->
  <target name="compile" depends="init" description="compile the source">
    <depend srcdir="${src}" destdir="${build}"
           cache="build/depend/"
           closure="true" />
    <javac srcdir="${src}" destdir="${build}"
           deprecation="true"
           debug="true" 
           debuglevel="lines,vars,source"
    	   target="1.5">
           <classpath>
             <fileset dir="${env.ECLIPSE_HOME}/plugins/">
                 <include name="**/*.jar"/>
             </fileset>
             <fileset dir="${src}/../../infr_libs_java/export/jars/">
                 <include name="**/*.jar"/>
             </fileset>
           </classpath>
    </javac>
  </target>

  <!-- Create the distribution directory + jar files -->
  <target name="dist" depends="compile" description="generate the distribution" >
    <mkdir dir="${dist}/../lib"/>

    <!-- Copy xta images/icons -->
  	<copy file="${src}/com/xmos/xta/swing/XmosTM.jpg"              todir="${build}/com/xmos/xta/swing"/>
  	<copy file="${src}/com/xmos/xta/swing/yellowled.png"           todir="${build}/com/xmos/xta/swing"/>
  	<copy file="${src}/com/xmos/xta/swing/AbsolutePath.png"        todir="${build}/com/xmos/xta/swing"/>
  	<copy file="${src}/com/xmos/xta/swing/AbsolutePathFolded.png"  todir="${build}/com/xmos/xta/swing"/>
  	<copy file="${src}/com/xmos/xta/swing/AbsolutePathUnknown.png" todir="${build}/com/xmos/xta/swing"/>
  	<copy file="${src}/com/xmos/xta/swing/BasicBlock.png"          todir="${build}/com/xmos/xta/swing"/>
  	<copy file="${src}/com/xmos/xta/swing/BasicBlockUnknown.png"   todir="${build}/com/xmos/xta/swing"/>
  	<copy file="${src}/com/xmos/xta/swing/folder.png"              todir="${build}/com/xmos/xta/swing"/>
  	<copy file="${src}/com/xmos/xta/swing/Loop.png"                todir="${build}/com/xmos/xta/swing"/>
  	<copy file="${src}/com/xmos/xta/swing/LoopUnknown.png"         todir="${build}/com/xmos/xta/swing"/>
  	<copy file="${src}/com/xmos/xta/swing/Path.png"                todir="${build}/com/xmos/xta/swing"/>
  	<copy file="${src}/com/xmos/xta/swing/PathUnknown.png"         todir="${build}/com/xmos/xta/swing"/>
  	<copy file="${src}/com/xmos/xta/swing/Routes.png"              todir="${build}/com/xmos/xta/swing"/>
  	<copy file="${src}/com/xmos/xta/swing/warning.png"             todir="${build}/com/xmos/xta/swing"/>
  	<copy file="${src}/com/xmos/xta/swing/xta.gif"                 todir="${build}/com/xmos/xta/swing"/>

    <jar jarfile="${dist}/../lib/xta.jar"
         basedir="${build}"
         includes="com/xmos/xta/**"
         manifest="${src}/manifests/xta">
         <zipfileset src="${src}/../../infr_libs_java/export/jars/dwarfhandler.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/elfhandler.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/xeobject.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/xehandler.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/xeloader.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/isa.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/util.jar"/>
    </jar>
    
    <jar jarfile="${dist}/../lib/xtaswing.jar"
         basedir="${build}"
         includes="com/xmos/xta/**,
                   com/xmos/xeobjectdisplayer/**"
         manifest="${src}/manifests/xtaswing">
         <zipfileset src="${src}/../../infr_libs_java/export/jars/dwarfhandler.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/elfhandler.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/xeobject.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/xehandler.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/xeloader.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/isa.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/util.jar"/>
    </jar>
  </target>

  <!-- Delete the ${build} and ${dist} directory trees -->
  <target name="clean" description="clean up" >
    <delete dir="${build}"/>
    <delete dir="${dist}"/>
  	<delete dir="${dist}/../lib"/>
  </target>

</project>
