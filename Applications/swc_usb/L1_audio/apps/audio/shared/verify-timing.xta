load apps/audio/xtreme-v2/bin/xtreme-v2.xe

config threads 4

add branch wait1 NextRxWord
add branch wait2 NextRxWord
add branch wait1 RxALow
add branch wait2 RxALow

analyse path ReadDataPidByte NextRxWord
set required - 133 ns
analyse path NextRxWord NextRxWord
set required - 67 ns
analyse path StoreTailDataOut ReadToken_PID
set required - 200 ns


print summary 
exit









