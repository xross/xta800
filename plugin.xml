<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

   <extension
         id="application"
         point="org.eclipse.core.runtime.applications">
      <application>
         <run
               class="com.xmos.xta.rcp.Application">
         </run>
      </application>
   </extension>
   <extension
         point="org.eclipse.ui.perspectives">
      <perspective
            class="com.xmos.xta.rcp.XtaPerspective"
            icon="icons/xta.png"
            id="com.xmos.xta.rcp.XtaPerspective"
            name="Xta">
      </perspective>
   </extension>
   <extension
         point="org.eclipse.ui.editors">
      <editor
            class="com.xmos.xta.rcp.editors.SourcesEditor"
            default="false"
            id="com.xmos.xta.rcp.editors.Sources"
            name="Sources">
      </editor>
      <editor
            class="com.xmos.xta.rcp.editors.XtaEditor"
            default="false"
            id="com.xmos.xta.rcp.editors.XtaEditor"
            name="XtaEditor">
      </editor>
   </extension>
   <extension
         point="org.eclipse.ui.views">
      <view
            class="com.xmos.xta.rcp.views.TreeView.TreeView"
            icon="icons/tree.png"
            id="com.xmos.xta.rcp.views.TreeView.Tree"
            name="Tree"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.rcp.views.ConsoleView.ConsoleView"
            icon="icons/console.png"
            id="com.xmos.xta.rcp.views.ConsoleView.Console"
            name="Console"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.rcp.views.LogView.LogView"
            icon="icons/log.png"
            id="com.xmos.xta.rcp.views.LogView.Log"
            name="Log"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.rcp.views.FunctionView.FunctionView"
