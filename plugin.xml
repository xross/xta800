<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

   <extension
         id="application"
         point="org.eclipse.core.runtime.applications">
      <application>
         <run
               class="com.xmos.xtagui.Application">
         </run>
      </application>
   </extension>
   <extension
         point="org.eclipse.ui.perspectives">
      <perspective
            name="Xta Perspective"
            class="com.xmos.xtagui.Perspective"
            id="com.xmos.xtagui.Perspective">
      </perspective>
   </extension>
   <extension
         point="org.eclipse.ui.editors">
      <editor
            class="com.xmos.xtagui.editors.Sources"
            default="false"
            id="com.xmos.xtagui.editors.Sources"
            name="Sources">
      </editor>
   </extension>
   <extension
         point="org.eclipse.ui.views">
      <view
            class="com.xmos.xtagui.views.ControlView"
            id="com.xmos.xtagui.views.Control"
            name="Control"
            restorable="true">
      </view>
      <view
            class="com.xmos.xtagui.views.TreeView"
            id="com.xmos.xtagui.views.Tree"
            name="Tree"
            restorable="true">
      </view>
      <view
            class="com.xmos.xtagui.views.LoopView"
            id="com.xmos.xtagui.views.Loop"
            name="Loop"
            restorable="true">
      </view>
      <view
            class="com.xmos.xtagui.views.ConsoleView"
            id="com.xmos.xtagui.views.Console"
            name="Console"
            restorable="true">
      </view>
      <view
            class="com.xmos.xtagui.views.ErrorsView"
            id="com.xmos.xtagui.views.Errors"
            name="Errors"
            restorable="true">
      </view>
      <view
            class="com.xmos.xtagui.views.FunctionView"
            id="com.xmos.xtagui.views.Function"
            name="Function"
            restorable="true">
      </view>
      <view
            class="com.xmos.xtagui.views.FlowView"
            id="com.xmos.xtagui.views.Flow"
            name="Flow"
            restorable="true">
      </view>
      <view
            class="com.xmos.xtagui.views.StructureView"
            id="com.xmos.xtagui.views.Structure"
            name="Structure"
            restorable="true">
      </view>
   </extension>
   <extension
         point="org.eclipse.ui.commands">
      <command
            defaultHandler="com.xmos.xtagui.handlers.LoadHandler"
            id="com.xmos.xtagui.load.command"
            name="com.xmos.xtagui.load.command">
      </command>
      <command
            defaultHandler="com.xmos.xtagui.handlers.RunHandler"
            id="com.xmos.xtagui.run.command"
            name="com.xmos.xtagui.run.command">
      </command>
   </extension>
  <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="toolbar:com.xmos.xtagui.views.Control">
         <command
               commandId="com.xmos.xtagui.load.command"
               icon="src/com/xmos/xtagui/icons/yellowdot.png"
               label="Load"
               style="push">
         </command>
         <command
               commandId="com.xmos.xtagui.run.command"
               icon="src/com/xmos/xtagui/icons/greendot.png"
               id="com.xmos.xtagui.run.command"
               label="Run"
               style="push">
         </command>
      </menuContribution>
   </extension>
 
</plugin>
