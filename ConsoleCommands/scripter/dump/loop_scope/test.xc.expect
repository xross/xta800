void f() {
    int res = 0;

    for (int i = 0; i < 10; ++i) {
        #pragma xta label "outer"
        for (int j = 0; j < 3; ++j) {
            #pragma xta label "inner"
            res += j;
        }
        res += i;
    }

    for (int i = 0; i < 10; ++i) {
        #pragma xta label "loop_iterations_0"
        for (int j = 0; j < 3; ++j) {
            #pragma xta label "loop_iterations_1"
            res += j;
        }
        res += i;
    }
}

void g() {
    #pragma xta call "f1" 
    f();
    #pragma xta call "f2" 
    f();
}
    
int main() {
    #pragma xta call "call_0"
    g();
    return 0;
}

