predepend:
	$(CD) $(XMOS_ROOT)$(SLASH)tools_xta$(SLASH)generation              $(THEN) $(MAKEDEPEND)
	$(CD) $(XMOS_ROOT)$(SLASH)tools_xta$(SLASH)Frontends$(SLASH)xta    $(THEN) $(MAKEDEPEND)

prelint:
	$(CD) $(XMOS_ROOT)$(SLASH)tools_xta$(SLASH)generation              $(THEN) $(MAKELINT)
	$(CD) $(XMOS_ROOT)$(SLASH)tools_xta$(SLASH)Frontends$(SLASH)xta    $(THEN) $(MAKELINT)
