#include <xs1.h>
#include <platform.h>

out port p = XS1_PORT_1A;
out port y = XS1_PORT_1B;

int foo(){
    int x = 0;
  
    for (int i = 0; i < 10; ++i) {
        x += i;
    }
    y <: x;
    return x;
}

int bar(){
    int x;
    while(1){
        p<:foo();
        #pragma xta endpoint "endpoint_0"
        p<:foo();
        p<:foo();
        p<:foo();
    }
    #pragma xta label "label_0"
    return x;
}

int main()
{
  return bar();
}

