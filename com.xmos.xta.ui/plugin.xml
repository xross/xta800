   <extension
         point="org.eclipse.ui.editors.annotationTypes">
      <type
         name="com.xmos.xta.ui.highlight"
         markerType=""
         markerSeverity="2">
      </type>
      <type
            markerSeverity="1"
            name="com.xmos.xta.ui.unknown">
      </type>
      <type
            markerSeverity="2"
            name="com.xmos.xta.ui.start">
      </type>
      <type
            markerSeverity="2"
            name="com.xmos.xta.ui.stop">
      </type>
      <type
            markerSeverity="0"
            name="com.xmos.xta.ui.startstop">
      </type>
      <type
            markerSeverity="0"
            name="com.xmos.xta.ui.endpoint">
      </type>
      <type
            markerSeverity="0"
            name="com.xmos.xta.ui.excluded">
      </type>
      <type
            markerSeverity="2"
            name="com.xmos.xta.ui.source">
      </type>
   </extension>
   <extension
         id="product"
         point="org.eclipse.core.runtime.products">
      <product
            application="com.xmos.xta.ui.application"
            name="xtagui">
         <property
               name="appName"
               value="xtagui">
         </property>
         <property
               name="aboutText"
               value="This is an unreleased/unsupported version. (build 9999)">
         </property>
         <property
          	name="windowImages" 
          	value="icons/xta16x16.png,icons/xta32x32.png,icons/xta48x48.png,icons/xta64x64.png,icons/xta128x128.png">
         </property>
         <property
               name="aboutImage"
               value="icons/xta.png">
         </property>
      </product>
   </extension>
   <extension
         point="org.eclipse.ui.actionSets">
      <actionSet
            id="xtagui.actionSet"
            label="controls"
            visible="false">
         <action
               class="com.xmos.xta.ui.actions.ActionOpenScriptEditor"
               icon="icons/open_script_editor.png"
               id="com.xmos.xta.ui.actions.openscripteditor"
               label="Open/Refresh Script Editor"
               style="push"
               toolbarPath="Normal/controls">
         </action>
         <action
               class="com.xmos.xta.ui.actions.ActionSettings"
               icon="icons/settings.png"
               id="com.xmos.xta.ui.actions.settings"
               label="Xta Settings"
               style="push"
               toolbarPath="Normal/controls">
         </action>
         <action
               class="com.xmos.xta.ui.actions.ActionAddDefine"
               icon="icons/add_define.png"
               id="com.xmos.xta.ui.actions.define"
               label="Add Define"
               style="push"
               toolbarPath="Normal/controls">
         </action>            
         <action
               class="com.xmos.xta.ui.actions.ActionRun"
               icon="icons/run.png"
               id="com.xmos.xta.ui.actions.run"
               label="Analyse Path"
               style="push"
               toolbarPath="Normal/controls">
         </action>         
         <action
               class="com.xmos.xta.ui.actions.ActionFunction"
               icon="icons/function.png"
               id="com.xmos.xta.ui.actions.function"
               label="Select Function to Analyse"
               style="pulldown"
               toolbarPath="Normal/controls">
         </action>
         <action
               class="com.xmos.xta.ui.actions.ActionCore"
               id="com.xmos.xta.ui.actions.core"
               label="Core 0"
               style="pulldown"
               toolbarPath="Normal/controls">
         </action>
         <action
               class="com.xmos.xta.ui.actions.ActionNode"
               id="com.xmos.xta.ui.actions.node"
               label="Node 0"
               style="pulldown"
               toolbarPath="Normal/controls">
         </action>         
         <action
               class="com.xmos.xta.ui.actions.ActionLoad"
               icon="icons/load.png"
               id="com.xmos.xta.ui.actions.load"
               label="Open Xe File"
               style="pulldown"
               toolbarPath="Normal/controls">
         </action>
      </actionSet>
   </extension>
   <extension
         point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension
            targetID="com.xmos.xta.ui.XtaPerspective">
         <actionSet
               id="xtagui.actionSet">
         </actionSet>
      </perspectiveExtension>
   </extension>
   <extension
         point="org.eclipse.ui.startup">
      <startup
            class="com.xmos.xta.ui.views.routes.RoutesViewStartup">
      </startup>
      <startup
            class="com.xmos.xta.ui.GuiPerspectiveMonitor">
      </startup>
   </extension>
  
</plugin>
