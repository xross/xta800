<project name="tools_xta" default="dist" basedir=".">

  <!-- set global properties for this build -->
  <property name="src" location="src"/>
  <property name="build" location="build"/>
  <property name="buildlib" location="build/lib"/>
  <property name="dist"  location="dist"/>

  <!-- Create the build directory structure used by compile -->
  <target name="init">
    <tstamp/>
    <mkdir dir="${build}"/>
    <mkdir dir="${build}"/>
    <mkdir dir="${buildlib}"/>
  </target>

  <!-- Compile the java code from ${src} into ${build} -->
  <target name="compile" depends="init" description="compile the source">

    <depend srcdir="${src}" destdir="${build}"
           cache="build/depend/"
           closure="true" />
    <javac srcdir="${src}" destdir="${build}"
           deprecation="true"
           debug="true" 
           debuglevel="lines,vars,source"
           classpath="${src}/../../infr_libs_java/export/jars/dwarfhandler.jar:
                      ${src}/../../infr_libs_java/export/jars/elfhandler.jar:
                      ${src}/../../infr_libs_java/export/jars/xeobject.jar:
                      ${src}/../../infr_libs_java/export/jars/xehandler.jar:
                      ${src}/../../infr_libs_java/export/jars/xeloader.jar:
                      ${src}/../../infr_libs_java/export/jars/util.jar:
                      ${src}/../../infr_libs_java/export/jars/isa.jar"
    	   target="1.5">
    </javac>
  </target>

  <!-- Create the distribution directory + jar files -->
  <target name="dist" depends="compile" description="generate the distribution" >
    <mkdir dir="${dist}/../lib"/>

    <!-- Copy xta images/icons -->
  	<copy file="${src}/com/xmos/xta/gui/XmosTM.jpg"             todir="${build}/com/xmos/xta/gui"/>
  	<copy file="${src}/com/xmos/xta/gui/yellowled.png"          todir="${build}/com/xmos/xta/gui"/>
  	<copy file="${src}/com/xmos/xta/gui/AbsolutePath.png"       todir="${build}/com/xmos/xta/gui"/>
  	<copy file="${src}/com/xmos/xta/gui/AbsolutePathFolded.png" todir="${build}/com/xmos/xta/gui"/>
  	<copy file="${src}/com/xmos/xta/gui/BasicBlock.png"         todir="${build}/com/xmos/xta/gui"/>
  	<copy file="${src}/com/xmos/xta/gui/folder.png"             todir="${build}/com/xmos/xta/gui"/>
  	<copy file="${src}/com/xmos/xta/gui/Loop.png"               todir="${build}/com/xmos/xta/gui"/>
  	<copy file="${src}/com/xmos/xta/gui/Path.png"               todir="${build}/com/xmos/xta/gui"/>
  	<copy file="${src}/com/xmos/xta/gui/Routes.png"             todir="${build}/com/xmos/xta/gui"/>
  	<copy file="${src}/com/xmos/xta/gui/xta.gif"                todir="${build}/com/xmos/xta/gui"/>

    <jar jarfile="${dist}/../lib/xta.jar"
         basedir="${build}"
         includes="com/xmos/xta/**"
         manifest="${src}/manifests/xta">
         <zipfileset src="${src}/../../infr_libs_java/export/jars/dwarfhandler.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/elfhandler.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/xeobject.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/xehandler.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/xeloader.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/isa.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/util.jar"/>
    </jar>

    <jar jarfile="${dist}/../lib/xtatest.jar"
         basedir="${build}"
         includes="com/xmos/xta/**"
         manifest="${src}/manifests/xta">
         <zipfileset src="${src}/../../infr_libs_java/export/jars/dwarfhandler.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/elfhandler.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/xeobject.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/xehandler.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/xeloader.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/isa.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/util.jar"/>
    </jar>
    <jar jarfile="${dist}/../lib/xtagui.jar"
         basedir="${build}"
         includes="com/xmos/xta/**,
                   com/xmos/xeobjectdisplayer/**"
         manifest="${src}/manifests/xtagui">
         <zipfileset src="${src}/../../infr_libs_java/export/jars/dwarfhandler.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/elfhandler.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/xeobject.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/xehandler.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/xeloader.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/isa.jar"/>
         <zipfileset src="${src}/../../infr_libs_java/export/jars/util.jar"/>
    </jar>
  </target>

  <!-- Delete the ${build} and ${dist} directory trees -->
  <target name="clean" description="clean up" >
    <delete dir="${build}"/>
    <delete dir="${dist}"/>
  	<delete dir="${dist}/../lib"/>
  </target>

</project>
