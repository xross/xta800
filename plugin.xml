<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

   <extension
         id="application"
         point="org.eclipse.core.runtime.applications">
      <application>
         <run
               class="com.xmos.xta.gui.Application">
         </run>
      </application>
   </extension>
   <extension
         point="org.eclipse.ui.perspectives">
      <perspective
            class="com.xmos.xta.gui.XtaPerspective"
            icon="icons/xta.png"
            id="com.xmos.xta.gui.XtaPerspective"
            name="Xta">
      </perspective>
   </extension>
   <extension
         point="org.eclipse.ui.editors">
      <editor
            class="com.xmos.xta.gui.editors.SourcesEditor"
            default="false"
            icon="icons/editor.png"
            id="com.xmos.xta.gui.editors.Sources"
            name="Sources">
      </editor>
      <editor
            class="com.xmos.xta.gui.editors.XtaEditor"
            default="false"
            id="com.xmos.xta.gui.editors.XtaEditor"
            name="XtaEditor">
      </editor>
   </extension>
   <extension
         point="org.eclipse.ui.views">
      <view
            class="com.xmos.xta.gui.views.routes.RoutesView"
            icon="icons/tree.png"
            id="com.xmos.xta.gui.views.routes.Routes"
            name="Routes"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.gui.views.tree.TreeView"
            icon="icons/tree.png"
            id="com.xmos.xta.gui.views.tree.Tree"
            name="Tree"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.gui.views.console.ConsoleView"
            icon="icons/console.png"
            id="com.xmos.xta.gui.views.console.Console"
            name="Console"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.gui.views.log.LogView"
            icon="icons/log.png"
            id="com.xmos.xta.gui.views.log.Log"
            name="Log"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.gui.views.info.InfoView"
            icon="icons/unknowns.png"
            id="com.xmos.xta.gui.views.info.Info"
            name="Info"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.gui.views.control.ControlView"
            icon="icons/settings.png"
            id="com.xmos.xta.gui.views.control.Control"
            name="Control"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.gui.views.status.StatusView"
            icon="icons/status.png"
            id="com.xmos.xta.gui.views.status.Status"
            name="Status"
            restorable="true">
      </view>
   </extension>
  
   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="toolbar:com.xmos.xta.gui.views.FunctionView.Function">
      </menuContribution>
      <menuContribution
            locationURI="toolbar:com.xmos.xta.gui.views.StructureView.Structure">
      </menuContribution>
   </extension> <extension
         point="org.eclipse.ui.commands">command>
   </extension>
   <extension
         point="org.eclipse.ui.editors.markerAnnotationSpecification">
      <specification
            annotationType="com.xmos.xta.gui.highlight"
            colorPreferenceKey="errorIndicationColor"
            colorPreferenceValue="255,125,75"
            contributesToHeader="true"
            highlightPreferenceKey="errorIndicationHighlighting"
            highlightPreferenceValue="true"
            isGoToNextNavigationTarget="true"
            isGoToNextNavigationTargetKey="isErrorGoToNextNavigationTarget"
            isGoToPreviousNavigationTarget="true"
            isGoToPreviousNavigationTargetKey="isErrorGoToPreviousNavigationTarget"
            label="Highlight"
            overviewRulerPreferenceKey="errorIndicationInOverviewRuler"
            overviewRulerPreferenceValue="true"
            presentationLayer="6"
            showInNextPrevDropdownToolbarAction="true"
            showInNextPrevDropdownToolbarActionKey="showErrorInNextPrevDropdownToolbarAction"
            symbolicIcon="error"
            textPreferenceKey="errorIndication"
            textPreferenceValue="true"
            textStylePreferenceKey="errorTextStyle"
            textStylePreferenceValue="PROBLEM_UNDERLINE"
            verticalRulerPreferenceKey="errorIndicationInVerticalRuler"
            verticalRulerPreferenceValue="false">
      </specification>
      <specification
            annotationType="com.xmos.xta.gui.unknown"
            colorPreferenceKey="highlight.unknown.color"
            colorPreferenceValue="255,0,0"
            contributesToHeader="false"
            highlightPreferenceValue="false"
            includeOnPreferencePage="false"
            isGoToNextNavigationTarget="false"
            isGoToNextNavigationTargetKey="isErrorGoToNextNavigationTarget"
            isGoToPreviousNavigationTarget="false"
            isGoToPreviousNavigationTargetKey="isErrorGoToPreviousNavigationTarget"
            label="Unknown"
            overviewRulerPreferenceKey="highlight.unknown.rulers.overview"
            overviewRulerPreferenceValue="true"
            presentationLayer="7"
            showInNextPrevDropdownToolbarAction="false"
            showInNextPrevDropdownToolbarActionKey="showErrorInNextPrevDropdownToolbarAction"
            symbolicIcon="warning"
            textPreferenceKey="highlight.unknown.text"
            textPreferenceValue="false"
            textStylePreferenceValue="NONE"
            verticalRulerPreferenceKey="highlight.unknown.rulers.vertical"
            verticalRulerPreferenceValue="true">
      </specification>
      <specification
            annotationType="com.xmos.xta.gui.start"
            colorPreferenceKey="highlight.endpoint.color"
            colorPreferenceValue="40,40,215"
            contributesToHeader="false"
            highlightPreferenceValue="false"
            icon="icons/source_endpoint_start.png"
            includeOnPreferencePage="false"
            isGoToNextNavigationTarget="false"
            isGoToNextNavigationTargetKey="isErrorGoToNextNavigationTarget"
            isGoToPreviousNavigationTarget="false"
            isGoToPreviousNavigationTargetKey="isErrorGoToPreviousNavigationTarget"
            label="Start"
            overviewRulerPreferenceKey="highlight.endpoint.rulers.overview"
            overviewRulerPreferenceValue="true"
            presentationLayer="5"
            showInNextPrevDropdownToolbarAction="false"
            showInNextPrevDropdownToolbarActionKey="showErrorInNextPrevDropdownToolbarAction"
            symbolicIcon="warning"
            textPreferenceKey="highlight.endpoint.text"
            textPreferenceValue="false"
            textStylePreferenceValue="NONE"
            verticalRulerPreferenceKey="highlight.endpoint.rulers.vertical"
            verticalRulerPreferenceValue="true">
      </specification>
      <specification
            annotationType="com.xmos.xta.gui.stop"
            colorPreferenceKey="highlight.endpoint.color"
            colorPreferenceValue="40,40,215"
            contributesToHeader="false"
            highlightPreferenceValue="false"
            icon="icons/source_endpoint_stop.png"
            includeOnPreferencePage="false"
            isGoToNextNavigationTarget="false"
            isGoToNextNavigationTargetKey="isErrorGoToNextNavigationTarget"
            isGoToPreviousNavigationTarget="false"
            isGoToPreviousNavigationTargetKey="isErrorGoToPreviousNavigationTarget"
            label="Stop"
            overviewRulerPreferenceKey="highlight.endpoint.rulers.overview"
            overviewRulerPreferenceValue="true"
            presentationLayer="5"
            showInNextPrevDropdownToolbarAction="false"
            showInNextPrevDropdownToolbarActionKey="showErrorInNextPrevDropdownToolbarAction"
            symbolicIcon="warning"
            textPreferenceKey="highlight.endpoint.text"
            textPreferenceValue="false"
            textStylePreferenceValue="NONE"
            verticalRulerPreferenceKey="highlight.endpoint.rulers.vertical"
            verticalRulerPreferenceValue="true">
      </specification>
      <specification
            annotationType="com.xmos.xta.gui.startstop"
            colorPreferenceKey="highlight.endpoint.color"
            colorPreferenceValue="40,40,215"
            contributesToHeader="false"
            highlightPreferenceValue="false"
            icon="icons/source_endpoint_startstop.png"
            includeOnPreferencePage="false"
            isGoToNextNavigationTarget="false"
            isGoToNextNavigationTargetKey="isErrorGoToNextNavigationTarget"
            isGoToPreviousNavigationTarget="false"
            isGoToPreviousNavigationTargetKey="isErrorGoToPreviousNavigationTarget"
            label="StartStop"
            overviewRulerPreferenceKey="highlight.endpoint.rulers.overview"
            overviewRulerPreferenceValue="true"
            presentationLayer="5"
            showInNextPrevDropdownToolbarAction="false"
            showInNextPrevDropdownToolbarActionKey="showErrorInNextPrevDropdownToolbarAction"
            symbolicIcon="warning"
            textPreferenceKey="highlight.endpoint.text"
            textPreferenceValue="false"
            textStylePreferenceValue="NONE"
            verticalRulerPreferenceKey="highlight.endpoint.rulers.vertical"
            verticalRulerPreferenceValue="true">
      </specification>
      <specification
            annotationType="com.xmos.xta.gui.endpoint"
            colorPreferenceKey="highlight.endpoint.color"
            colorPreferenceValue="40,40,215"
            contributesToHeader="false"
            highlightPreferenceValue="false"
            icon="icons/source_endpoint.png"
            includeOnPreferencePage="false"
            isGoToNextNavigationTarget="false"
            isGoToNextNavigationTargetKey="isErrorGoToNextNavigationTarget"
            isGoToPreviousNavigationTarget="false"
            isGoToPreviousNavigationTargetKey="isErrorGoToPreviousNavigationTarget"
            label="Endpoint"
            overviewRulerPreferenceKey="highlight.endpoint.rulers.overview"
            overviewRulerPreferenceValue="true"
            presentationLayer="5"
            showInNextPrevDropdownToolbarAction="false"
            showInNextPrevDropdownToolbarActionKey="showErrorInNextPrevDropdownToolbarAction"
            symbolicIcon="warning"
            textPreferenceKey="highlight.endpoint.text"
            textPreferenceValue="false"
            textStylePreferenceValue="NONE"
            verticalRulerPreferenceKey="highlight.endpoint.rulers.vertical"
            verticalRulerPreferenceValue="true">
      </specification>
      <specification
            annotationType="com.xmos.xta.gui.excluded"
            colorPreferenceKey="highlight.excluded.color"
            colorPreferenceValue="0,0,0"
            contributesToHeader="false"
            highlightPreferenceValue="false"
            icon="icons/excluded.png"
            includeOnPreferencePage="false"
            isGoToNextNavigationTarget="false"
            isGoToNextNavigationTargetKey="isErrorGoToNextNavigationTarget"
            isGoToPreviousNavigationTarget="false"
            isGoToPreviousNavigationTargetKey="isErrorGoToPreviousNavigationTarget"
            label="Excluded"
            overviewRulerPreferenceKey="highlight.excluded.rulers.overview"
            overviewRulerPreferenceValue="true"
            presentationLayer="5"
            showInNextPrevDropdownToolbarAction="false"
            showInNextPrevDropdownToolbarActionKey="showErrorInNextPrevDropdownToolbarAction"
            symbolicIcon="warning"
            textPreferenceKey="highlight.excluded.text"
            textPreferenceValue="false"
            textStylePreferenceValue="NONE"
            verticalRulerPreferenceKey="highlight.excluded.rulers.vertical"
            verticalRulerPreferenceValue="true">
      </specification>
   </extension>
 
   <extension
         point="org.eclipse.ui.editors.annotationTypes">
      <type
         name="com.xmos.xta.gui.highlight"
         super="org.eclipse.ui.workbench.texteditor.error"
         markerType=""
         markerSeverity="1">
      </type>
      <type
            markerSeverity="1"
            name="com.xmos.xta.gui.unknown"
            super="org.eclipse.ui.workbench.texteditor.info">
      </type>
      <type
            markerSeverity="2"
            name="com.xmos.xta.gui.start"
            super="org.eclipse.ui.workbench.texteditor.info">
      </type>
      <type
            markerSeverity="2"
            name="com.xmos.xta.gui.stop"
            super="org.eclipse.ui.workbench.texteditor.info">
      </type>
      <type
            markerSeverity="2"
            name="com.xmos.xta.gui.startstop"
            super="org.eclipse.ui.workbench.texteditor.info">
      </type>
      <type
            markerSeverity="2"
            name="com.xmos.xta.gui.endpoint"
            super="org.eclipse.ui.workbench.texteditor.info">
      </type>
      <type
            markerSeverity="2"
            name="com.xmos.xta.gui.excluded"
            super="org.eclipse.ui.workbench.texteditor.info">
      </type>
   </extension>
   <extension
         id="product"
         point="org.eclipse.core.runtime.products">
      <product
            application="tools_xta.application"
            name="xta">
         <property
               name="appName"
               value="xta">
         </property>
         <property
               name="aboutText"
               value="This is an unreleased/unsupported version. (build xxxx)">
         </property>
         <property
          	name="windowImages" 
          	value="icons/xta16x16.png,icons/xta32x32.png">
         </property>
      </product>
   </extension>
  
</plugin>
