      <command
            defaultHandler="com.xmos.xta.rcp.handlers.StructureZoomInHandler"
            id="com.xmos.xta.rcp.structure.zoomin.command"
            name="com.xmos.xta.rcp.structure.zoomin.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.rcp.handlers.StructureZoomOutHandler"
            id="com.xmos.xta.rcp.structure.zoomout.command"
            name="com.xmos.xta.rcp.structure.zoomout.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.rcp.handlers.StructureZoomResetHandler"
            id="com.xmos.xta.rcp.structure.zoomreset.command"
            name="com.xmos.xta.rcp.structure.zoomreset.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.rcp.handlers.FunctionZoomInHandler"
            id="com.xmos.xta.rcp.function.zoomin.command"
            name="com.xmos.xta.rcp.function.zoomin.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.rcp.handlers.FunctionZoomOutHandler"
            id="com.xmos.xta.rcp.function.zoomout.command"
            name="com.xmos.xta.rcp.function.zoomout.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.rcp.handlers.FunctionZoomResetHandler"
            id="com.xmos.xta.rcp.function.zoomreset.command"
            name="com.xmos.xta.rcp.function.zoomreset.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.rcp.handlers.FunctionZoomFitHandler"
            id="com.xmos.xta.rcp.function.zoomfit.command"
            name="com.xmos.xta.rcp.function.zoomfit.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.rcp.handlers.StructureCumulativeHandler"
            id="com.xmos.xta.rcp.structure.cumulative.command"
            name="com.xmos.xta.rcp.structure.cumulative.command">
      </command>command>
   </extension>
