	</Platforms>
	<ToolFiles>
	</ToolFiles>
	<Configurations>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory="$(ConfigurationName)"
			IntermediateDirectory="$(ConfigurationName)"
			ConfigurationType="0"
			>
			<Tool
				Name="VCNMakeTool"
				BuildCommandLine="nmake -f MakefilePc.mak CONFIG=$(ConfigurationName) HOST=PC DOMAIN=$(XMOS_ROOT)/infr_tools_cpp"
				ReBuildCommandLine="nmake -f MakefilePc.mak CONFIG=$(ConfigurationName) HOST=PC DOMAIN=$(XMOS_ROOT)/infr_tools_cpp clean all"
				CleanCommandLine="nmake -f MakefilePc.mak CONFIG=$(ConfigurationName) HOST=PC DOMAIN=$(XMOS_ROOT)/infr_tools_cpp clean"
				Output="XtaGeneration.exe"
				PreprocessorDefinitions="WIN32;_DEBUG"
				IncludeSearchPath=""
				ForcedIncludes=""
				AssemblySearchPath=""
				ForcedUsingAssemblies=""
				CompileAsManaged=""
			/>
		</Configuration>
