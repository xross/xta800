#include <print.h>

void printchar_test(){
char a = 'a';
printchar(a);
}
void printcharln_test(){
char a = 'a';
printcharln(a);
}

void printint_test(){
int b = 4;
printint(b);
}

void printintln_test(){
int b = 4;
printintln(b);
}

void printuint_test(){
unsigned c = 6;
printuint(c);
}

void printuintln_test(){
unsigned c = 6;	
printuintln(c);
}

void printhex_test(){
unsigned c = 6;
printhex(c);
}
	
void printhexln_test(){
unsigned c = 6;
printhexln(c);
}

void printstr_test(){
char s[] = "hello";
printstr(s);
}

void printstrln_test(){	
char s[] = "hello";
printstrln(s);
}


