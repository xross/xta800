<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

   <extension
         id="application"
         point="org.eclipse.core.runtime.applications">
      <application>
         <run
               class="com.xmos.xta.gui.Application">
         </run>
      </application>
   </extension>
   <extension
         point="org.eclipse.ui.perspectives">
      <perspective
            class="com.xmos.xta.gui.XtaPerspective"
            icon="icons/xta16x16.png"
            id="com.xmos.xta.gui.XtaPerspective"
            name="Xta">
      </perspective>
   </extension>
   <extension
         point="org.eclipse.ui.editors">
      <editor
            class="com.xmos.xta.gui.editors.SourcesEditor"
            default="false"
            icon="icons/editor.png"
            id="com.xmos.xta.gui.editors.Sources"
            name="Xta">
      </editor>
      <editor
            class="com.xmos.xta.gui.editors.XtaEditor"
            default="false"
            id="com.xmos.xta.gui.editors.XtaEditor"
            name="XtaEditor">
      </editor>
   </extension>
   <extension
         point="org.eclipse.ui.views">
      <view
            class="com.xmos.xta.gui.views.routes.RoutesView"
            icon="icons/tree.png"
            id="com.xmos.xta.gui.views.routes.Routes"
            name="Routes"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.gui.views.console.ConsoleView"
            icon="icons/console.png"
            id="com.xmos.xta.gui.views.console.Console"
            name="Console"
            restorable="true">
      </view>
	  <view
			class="com.xmos.xta.gui.views.structure.StructureView"
  			icon="icons/structure.png"
			id="com.xmos.xta.gui.views.structure.Structure"
  			name="Structure"
  			restorable="true">
  	  </view>
      <view
            class="com.xmos.xta.gui.views.info.InfoView"
            icon="icons/unknowns.png"
            id="com.xmos.xta.gui.views.info.Info"
            name="Info"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.gui.views.function.FunctionView"
            icon="icons/function_view.png"
            id="com.xmos.xta.gui.views.function.Function"
            name="Function"
            restorable="true">
      </view>
   </extension>
  
   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="toolbar:com.xmos.xta.gui.views.function.Function">
         <command
               commandId="com.xmos.xta.gui.function.zoomin.command"
               icon="icons/zoomin.png"
               id="com.xmos.xta.gui.function.zoomin.command"
               label="Zoom In"
               style="push">
         </command>
         <command
               commandId="com.xmos.xta.gui.function.zoomout.command"
               icon="icons/zoomout.png"
               id="com.xmos.xta.gui.function.zoomout.command"
               label="Zoom Out"
               style="push">
         </command>
         <command
               commandId="com.xmos.xta.gui.function.zoomreset.command"
               icon="icons/zoomreset.png"
               id="com.xmos.xta.gui.function.zoomreset.command"
               label="Reset Zoom"
               style="push">
         </command>
         <command
               commandId="com.xmos.xta.gui.function.zoomfit.command"
               icon="icons/zoomfit.png"
               id="com.xmos.xta.gui.function.zoomfit.command"
               label="Zoom to fit"
               style="push">
         </command>
      </menuContribution>
      <menuContribution
            locationURI="toolbar:com.xmos.xta.gui.views.structure.Structure">
            <command
				commandId="com.xmos.xta.gui.structure.zoomin.command"
				icon="icons/zoomin.png"
				id="com.xmos.xta.gui.structure.zoomin.command"
				label="Zoom In"
				style="push">
			</command>
			<command
				commandId="com.xmos.xta.gui.structure.zoomout.command"
				icon="icons/zoomout.png"
				id="com.xmos.xta.gui.structure.zoomout.command"
				label="Zoom Out"
				style="push">
			</command>
			<command
				commandId="com.xmos.xta.gui.structure.zoomreset.command"
				icon="icons/zoomreset.png"
				id="com.xmos.xta.gui.structure.zoomreset.command"
				label="Reset Zoom"
				style="push">
			</command>
   <command
         commandId="com.xmos.xta.gui.structure.zoomfit.command"
         icon="icons/zoomfit.png"
         id="com.xmos.xta.gui.structure.zoomfit.command"
         label="Zoom to fit"
         style="push">
   </command>
		</menuContribution>
   </extension>
   <extension
         point="org.eclipse.ui.commands">
	<command
            defaultHandler="com.xmos.xta.gui.handlers.StructureZoomInHandler"
            id="com.xmos.xta.gui.structure.zoomin.command"
            name="com.xmos.xta.gui.structure.zoomin.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.gui.handlers.StructureZoomOutHandler"
            id="com.xmos.xta.gui.structure.zoomout.command"
            name="com.xmos.xta.gui.structure.zoomout.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.gui.handlers.StructureZoomResetHandler"
            id="com.xmos.xta.gui.structure.zoomreset.command"
            name="com.xmos.xta.gui.structure.zoomreset.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.gui.handlers.StructureZoomFitHandler"
            id="com.xmos.xta.gui.structure.zoomfit.command"
            name="com.xmos.xta.gui.structure.zoomfit.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.gui.handlers.FunctionZoomInHandler"
            id="com.xmos.xta.gui.function.zoomin.command"
            name="com.xmos.xta.gui.function.zoomin.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.gui.handlers.FunctionZoomOutHandler"
            id="com.xmos.xta.gui.function.zoomout.command"
            name="com.xmos.xta.gui.function.zoomout.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.gui.handlers.FunctionZoomResetHandler"
            id="com.xmos.xta.gui.function.zoomreset.command"
            name="com.xmos.xta.gui.function.zoomreset.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.gui.handlers.FunctionZoomFitHandler"
            id="com.xmos.xta.gui.function.zoomfit.command"
            name="com.xmos.xta.gui.function.zoomfit.command">
      </command>
   </extension>
   <extension
         point="org.eclipse.ui.editors.markerAnnotationSpecification">
