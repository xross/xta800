   </extension>
  
   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="toolbar:com.xmos.xta.rcp.views.FunctionView.Function">
         <command
               commandId="com.xmos.xta.rcp.function.zoomin.command"
               icon="icons/zoomin.png"
               id="com.xmos.xta.rcp.function.zoomin.command"
               label="Zoom In"
               style="push">
         </command>
         <command
               commandId="com.xmos.xta.rcp.function.zoomout.command"
               icon="icons/zoomout.png"
               id="com.xmos.xta.rcp.function.zoomout.command"
               label="Zoom Out"
               style="push">
         </command>
         <command
               commandId="com.xmos.xta.rcp.function.zoomreset.command"
               icon="icons/zoomreset.png"
               id="com.xmos.xta.rcp.function.zoomreset.command"
               label="Reset Zoom"
               style="push">
         </command>
         <command
               commandId="com.xmos.xta.rcp.function.zoomfit.command"
               icon="icons/zoomfit.png"
               id="com.xmos.xta.rcp.function.zoomfit.command"
               label="Zoom to fit"
               style="push">
         </command>
      </menuContribution>
      <menuContribution
            locationURI="toolbar:com.xmos.xta.rcp.views.StructureView.Structure">
         <command
               commandId="com.xmos.xta.rcp.structure.zoomin.command"
               icon="icons/zoomin.png"
               id="com.xmos.xta.rcp.structure.zoomin.command"
               label="Zoom In"
               style="push">
         </command>
         <command
               commandId="com.xmos.xta.rcp.structure.zoomout.command"
               icon="icons/zoomout.png"
               id="com.xmos.xta.rcp.structure.zoomout.command"
               label="Zoom Out"
               style="push">
         </command>
         <command
               commandId="com.xmos.xta.rcp.structure.zoomreset.command"
               icon="icons/zoomreset.png"
               id="com.xmos.xta.rcp.structure.zoomreset.command"
               label="Reset Zoom"
               style="push">
         </command>
         <command
               commandId="com.xmos.xta.rcp.structure.cumulative.command"
               icon="icons/cumulative.png"
               id="com.xmos.xta.rcp.structure.cumulative.command"
               label="Cumulative weights"
               style="push">
         </command>
      </menuContribution>
