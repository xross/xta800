

add exclusion the_great_outdoors
analyze path x x

analyze endpoints test.xc:22 test.xc:23
scripter listrefs
scripter rename test.xc:22 "a space"
scripter rename test.xc:22 start
scripter listrefs
scripter rename test.xc:23 stop
scripter listrefs

scripter disable stop
scripter listrefs

scripter disable test.xc:22
scripter listrefs

scripter enable SOURCE:22
scripter listrefs

analyze path SOURCE:22 SOURCE:23

scripter disable test.xc:22
scripter disable test.xc:23
scripter listrefs

scripter rename x y

scripter dump
exit
