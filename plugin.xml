   <extension
         point="org.eclipse.ui.editors.annotationTypes">
      <type
         name="com.xmos.xta.gui.highlight"
         markerType=""
         markerSeverity="2">
      </type>
      <type
            markerSeverity="1"
            name="com.xmos.xta.gui.unknown">
      </type>
      <type
            markerSeverity="2"
            name="com.xmos.xta.gui.start">
      </type>
      <type
            markerSeverity="2"
            name="com.xmos.xta.gui.stop">
      </type>
      <type
            markerSeverity="0"
            name="com.xmos.xta.gui.startstop">
      </type>
      <type
            markerSeverity="0"
            name="com.xmos.xta.gui.endpoint">
      </type>
      <type
            markerSeverity="0"
            name="com.xmos.xta.gui.excluded">
      </type>
   </extension>
   <extension
         id="product"
         point="org.eclipse.core.runtime.products">
      <product
            application="tools_xta.application"
            name="xta">
         <property
               name="appName"
               value="xta">
         </property>
         <property
               name="aboutText"
               value="This is an unreleased/unsupported version. (build xxxx)">
         </property>
         <property
          	name="windowImages" 
          	value="icons/xta16x16.png,icons/xta32x32.png">
         </property>
      </product>
   </extension>
   <extension
         point="org.eclipse.ui.actionSets">
      <actionSet
            id="tools_xta.actionSet"
            label="controls"
            visible="false">
         <action
               class="com.xmos.xta.gui.actions.ActionSettings"
               icon="icons/settings.png"
               id="com.xmos.xta.gui.actions.settings"
               label="Xta Settings"
               style="push"
               toolbarPath="Normal/controls">
         </action>            
         <action
               class="com.xmos.xta.gui.actions.ActionCore"
               icon="icons/core.png"
               id="com.xmos.xta.gui.actions.core"
               label="Core 0"
               style="pulldown"
               toolbarPath="Normal/controls">
         </action>            
         <action
               class="com.xmos.xta.gui.actions.ActionNode"
               icon="icons/node.png"
               id="com.xmos.xta.gui.actions.node"
               label="Node 0"
               style="pulldown"
               toolbarPath="Normal/controls">
         </action>
         <action
               class="com.xmos.xta.gui.actions.ActionRun"
               icon="icons/run.png"
               id="com.xmos.xta.gui.actions.run"
               label="Analyse Path"
               style="push"
               toolbarPath="Normal/controls">
         </action>         
         <action
               class="com.xmos.xta.gui.actions.ActionFunction"
               icon="icons/function.png"
               id="com.xmos.xta.gui.actions.function"
               label="Select Function to Analyse"
               style="pulldown"
               toolbarPath="Normal/controls">
         </action>         
         <action
               class="com.xmos.xta.gui.actions.ActionLoad"
               icon="icons/load.png"
               id="com.xmos.xta.gui.actions.load"
               label="Open Xe File"
               style="push"
               toolbarPath="Normal/controls">
         </action>
      </actionSet>
   </extension>
   <extension
         point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension
            targetID="com.xmos.xta.gui.XtaPerspective">
         <actionSet
               id="tools_xta.actionSet">
         </actionSet>
      </perspectiveExtension>
   </extension>
  
</plugin>
