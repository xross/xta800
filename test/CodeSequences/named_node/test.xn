<?xml version="1.0" encoding="UTF-8"?>
<Network xmlns="http://www.xmos.com"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://www.xmos.com http://www.xmos.com">

  <Declarations>
    <Declaration>tileref tile[16]</Declaration>
  </Declarations>

  <Packages>
    <Package id="0" Type="XS1-G4A-FB512">
      <Nodes>
        <Node Id="A" InPackageId="0" Type="XS1-G4A">
          <Tile Number="0" Reference="tile[0]"/>
          <Tile Number="1" Reference="tile[1]"/>
          <Tile Number="2" Reference="tile[2]"/>
          <Tile Number="3" Reference="tile[3]"/>
        </Node>
      </Nodes>
    </Package>
    <Package id="1" Type="XS1-G4A-FB512">
      <Nodes>
        <Node Id="B" InPackageId="0" Type="XS1-G4A">
          <Tile Number="0" Reference="tile[4]"/>
          <Tile Number="1" Reference="tile[5]"/>
          <Tile Number="2" Reference="tile[6]"/>
          <Tile Number="3" Reference="tile[7]"/>
        </Node>
      </Nodes>
    </Package>
    <Package id="2" Type="XS1-G4A-FB512">
      <Nodes>
        <Node Id="C" InPackageId="0" Type="XS1-G4A">
          <Tile Number="0" Reference="tile[8]"/>
          <Tile Number="1" Reference="tile[9]"/>
          <Tile Number="2" Reference="tile[10]"/>
          <Tile Number="3" Reference="tile[11]"/>
        </Node>
      </Nodes>
    </Package>
    <Package id="3" Type="XS1-G4A-FB512">
      <Nodes>
        <Node Id="D" InPackageId="0" Type="XS1-G4A">
          <Tile Number="0" Reference="tile[12]"/>
          <Tile Number="1" Reference="tile[13]"/>
          <Tile Number="2" Reference="tile[14]"/>
          <Tile Number="3" Reference="tile[15]"/>
        </Node>
      </Nodes>
    </Package>
  </Packages>

  <Links>
    <Link Encoding="5wire" Delays="0,1">
      <LinkEndpoint NodeId="A" Link="4"/>
      <LinkEndpoint NodeId="B" Link="5"/>
    </Link>
    <Link Encoding="5wire" Delays="0,1">
      <LinkEndpoint NodeId="B" Link="4"/>
      <LinkEndpoint NodeId="C" Link="5"/>
    </Link>
    <Link Encoding="5wire" Delays="0,1">
      <LinkEndpoint NodeId="C" Link="4"/>
      <LinkEndpoint NodeId="D" Link="5"/>
    </Link>
    <Link Encoding="5wire" Delays="0,1">
      <LinkEndpoint NodeId="D" Link="4"/>
      <LinkEndpoint NodeId="A" Link="5"/>
    </Link>
  </Links>

  <JTAGChain>
    <JTAGDevice NodeId="A"/>
    <JTAGDevice NodeId="B"/>
    <JTAGDevice NodeId="C"/>
    <JTAGDevice NodeId="D"/>
  </JTAGChain>

</Network>

