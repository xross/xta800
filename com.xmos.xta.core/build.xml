<project name="tools_xta" default="dist" basedir=".">
  <property environment="env"/>

  <property name="src" location="src"/>
  <property name="build" location="build"/>
  
  <target name="init">
    <tstamp/>
    <mkdir dir="${build}"/>
  </target>

  <target name="compile" depends="init" description="compile the source">
    <copy file="version.xml" todir="${build}"/>
    <depend srcdir="${src}" destdir="${build}"
           closure="true" />
    <javac srcdir="${src}" destdir="${build}"
           deprecation="true"
           debug="true" 
           debuglevel="lines,vars,source"
    	   target="1.5">
           <classpath>
             <fileset dir="../../infr_libs_java/export/jars/">
                 <include name="**/*.jar"/>
             </fileset>
             <fileset dir="../../infr_libs_java/com.xmos.libs/jars/">
                 <include name="**/*.jar"/>
             </fileset>
           </classpath>
    </javac>
  </target>

  <target name="dist" depends="compile" description="generate the distribution" >
    <mkdir dir="../export/jars"/>

    <jar jarfile="../export/jars/xta.jar"
         basedir="${build}"
         includes="com/xmos/xta/**, version.xml"
         manifest="manifests/xta">
         <zipfileset src="../../infr_libs_java/com.xmos.libs/jars/jline-0.9.94.jar"/>
         <zipfileset src="../../infr_libs_java/export/jars/dwarfhandler.jar"/>
         <zipfileset src="../../infr_libs_java/export/jars/elfhandler.jar"/>
         <zipfileset src="../../infr_libs_java/export/jars/xehandler.jar"/>
         <zipfileset src="../../infr_libs_java/export/jars/xeloader.jar"/>
         <zipfileset src="../../infr_libs_java/export/jars/xnloader.jar"/>
         <zipfileset src="../../infr_libs_java/export/jars/configloader.jar"/>
         <zipfileset src="../../infr_libs_java/export/jars/proginfoloader.jar"/>
         <zipfileset src="../../infr_libs_java/export/jars/isa.jar"/>
         <zipfileset src="../../infr_libs_java/export/jars/util.jar"/>
    </jar>
  </target>

  <target name="clean" description="clean up" >
    <delete dir="${build}"/>
  	<delete dir="../export/jars"/>
  </target>

</project>
