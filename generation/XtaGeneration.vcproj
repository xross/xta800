				ReBuildCommandLine="nmake -f MakefilePc.mak CONFIG=$(ConfigurationName) HOST=PC DOMAIN=$(XMOS_ROOT)/infr_tools_cpp clean all"
				CleanCommandLine="nmake -f MakefilePc.mak CONFIG=$(ConfigurationName) HOST=PC DOMAIN=$(XMOS_ROOT)/infr_tools_cpp clean"
				Output="XtaGeneration.exe"
				PreprocessorDefinitions="WIN32;NDEBUG"
				IncludeSearchPath=""
				ForcedIncludes=""
				AssemblySearchPath=""
				ForcedUsingAssemblies=""
				CompileAsManaged=""
			/>
		</Configuration>
	</Configurations>
