int func(int x) {
    int retval = 0;
    switch (x) {
        case 1:
            retval = 1;
            break;
        case 2:
            retval = 2;
            break;
        case 3:
            retval = 3;
            break;
        case 4:
            retval = 4;
            break;
        case 5:
            retval = 5;
            break;
    }
  return retval;
}
int y;
int main() {
    return func(y);
}

