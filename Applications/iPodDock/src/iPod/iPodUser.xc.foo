#include "iPod.h"
#include "remote_cmds.h"

int dspon = 0;
int ledval = 0;
int extended_mode = 0;

/*
 * iPod_UserPostAuth:
 * Called when authentication has completed
 */
void iPod_UserPostAuth(streaming_chanend ciPodHID, streaming chanend cAudioMixer[3], streaming chanend cLED)
{
  // Post authentication commands
#ifdef DSP_ENABLED
    dspon = 0;
    cAudioMixer[1] <: dspon;
    ledval &= ~2;
    cLED <: ledval;
#endif
    
  // Check digital audio lingo version
  {
    int majorversion, minorversion;
    int retval;
    if (iAP_generalLingo_RequestLingoProtocolVersion_client(ciPodHID, gettransid(), audioLingo, majorversion, minorversion))
      vprint("RLPV Failed");
    
    if (majorversion <= 1 && minorversion <= 1)
    {
      // Enter extended mode
      if (iAP_generalLingo_EnterRemoteUIMode_client(ciPodHID, gettransid(), retval)) {
	vprint("Enter RemoteUI (extended lingo) Failed");
      };
     extended_mode = 1;

     // Set up a Display image.
     // Mono simple image as proof of concept.
     { 
       // 2 bits per pixel, 32x32 = 1024 pixels = 256 bytes ( 4 pixels per byte).
       // This is 64 words of storage.
       
       char img_data[256] = {
	 0xff, 0xff, 0xf0, 0x00, 0x00, 0x0f, 0xff, 0xff, 
	 0x0c, 0x00, 0x0c, 0x00, 0x00, 0x30, 0x00, 0x30, 
	 0x03, 0x00, 0x03, 0x00, 0x00, 0xc0, 0x00, 0xc0, 
	 0x00, 0xc0, 0x00, 0xc0, 0x03, 0x00, 0x03, 0x00,
	 0x00, 0x30, 0x00, 0x30, 0x0c, 0x00, 0x0c, 0x00, 
	 0x00, 0x0c, 0x00, 0x0c, 0x30, 0x00, 0x30, 0x00, 
	 0x00, 0x03, 0x00, 0x03, 0xc0, 0x00, 0xc0, 0x00, 
	 0x00, 0x00, 0xc0, 0x00, 0x00, 0x03, 0x00, 0x00,

	 0x00, 0x00, 0xc0, 0x00, 0x00, 0x03, 0x00, 0x00,
	 0x00, 0x03, 0x00, 0x03, 0xc0, 0x00, 0xc0, 0x00, 
	 0x00, 0x0c, 0x00, 0x0c, 0x30, 0x00, 0x30, 0x00, 
	 0x00, 0x30, 0x00, 0x30, 0x0c, 0x00, 0x0c, 0x00, 
	 0x00, 0xc0, 0x00, 0xc0, 0x03, 0x00, 0x03, 0x00,
	 0x03, 0x00, 0x03, 0x00, 0x00, 0xc0, 0x00, 0xc0, 
	 0x0c, 0x00, 0x0c, 0x00, 0x00, 0x30, 0x00, 0x30, 
	 0xff, 0xff, 0xf0, 0x00, 0x00, 0x0f, 0xff, 0xff, 

	 0xff, 0xff, 0xf0, 0x00, 0x00, 0x0f, 0xff, 0xff, 
	 0x0c, 0x00, 0x0c, 0x00, 0x00, 0x30, 0x00, 0x30, 
	 0x03, 0x00, 0x03, 0x00, 0x00, 0xc0, 0x00, 0xc0, 
	 0x00, 0xc0, 0x00, 0xc0, 0x03, 0x00, 0x03, 0x00,
	 0x00, 0x30, 0x00, 0x30, 0x0c, 0x00, 0x0c, 0x00, 
	 0x00, 0x0c, 0x00, 0x0c, 0x30, 0x00, 0x30, 0x00, 
	 0x00, 0x03, 0x00, 0x03, 0xc0, 0x00, 0xc0, 0x00, 
	 0x00, 0x00, 0xc0, 0x00, 0x00, 0x03, 0x00, 0x00,

	 0x00, 0x00, 0xc0, 0x00, 0x00, 0x03, 0x00, 0x00,
	 0x00, 0x03, 0x00, 0x03, 0xc0, 0x00, 0xc0, 0x00, 
	 0x00, 0x0c, 0x00, 0x0c, 0x30, 0x00, 0x30, 0x00, 
	 0x00, 0x30, 0x00, 0x30, 0x0c, 0x00, 0x0c, 0x00, 
	 0x00, 0xc0, 0x00, 0xc0, 0x03, 0x00, 0x03, 0x00,
	 0x03, 0x00, 0x03, 0x00, 0x00, 0xc0, 0x00, 0xc0, 
	 0x0c, 0x00, 0x0c, 0x00, 0x00, 0x30, 0x00, 0x30, 
	 0xff, 0xff, 0xf0, 0x00, 0x00, 0x0f, 0xff, 0xff, 

       };
       int i;
#if 0
       for (i=0; i< 256; i++) {
	 if (i & 0x1) {
	   img_data[i] = 0xff;
	 } else {
	   img_data[i] = 0;
	 };
	 img_data[i] = 0x0f;
	 if (i & 0x10) {
	   img_data[i] = ~img_data[i];
	 };
       };
#endif

       if (iAP_extendedLingo_SetDisplayImage_client(ciPodHID, gettransid(), 0, 1, 32, 32, 8, img_data, 256, retval)) {
	 vprint ("SetDisplayImage failed");
       };
     }

     // Tell the ipod to play
     if (iAP_extendedLingo_PlayCurrentSelection_client(ciPodHID, gettransid(), 0, retval)) {
       vprint("Play current selection failed");
     };
    }
  }

}

/*
 * iPod_IR:
 * Called on receipt of an Infra-Red command
 */
int iPod_IR(streaming_chanend ciPodHID, unsigned irval, streaming chanend cAudioMixer[3], streaming chanend cLED)
{
  if (irval == REMOTE_CMD_MENU)
  {
#ifdef DSP_ENABLED
    dspon = !dspon;
    cAudioMixer[1] <: dspon;
    ledval ^= 2;
    cLED <: ledval;
#endif
  }
  else
  {
    int retval;
   if (extended_mode) {
      switch (irval) {
      case REMOTE_CMD_PLAY_PAUSE:
	irval = 0x1;
	break;
      case REMOTE_CMD_TRACK_NEXT:
	irval = 0x3;
	break;
      case REMOTE_CMD_TRACK_PREV:
	irval = 0x4;
	break;
      default:
	irval = 0;
	vprint("ERROR: unsupported IR Cmd");
	break;
      };
      if (irval != 0) {
	if(iAP_extendedLingo_PlayControl_client(ciPodHID, gettransid(), irval, retval)){
	  return 1;
	}
      };
    } else {
      if (iAP_simpleLingo_CONTEXTBUTTONSTATUS_client(ciPodHID, gettransid(), byterev(irval)))
	{
	  return 1;
	}
    }
  }
  return 0;
}

/*
 * Called every IPOD_TIME_INTERVAL by the iPod stack
 */ 
void iPod_timer(streaming_chanend ciPodHID, streaming chanend cAudioMixer[3], streaming chanend cLED)
{
  ledval ^= 1;
  cLED <: ledval;  
}

/*
 * iPod_UserUnsolicited:
 * Called when an unknown unsolicited iAP message was received
 */
int iPod_UserUnsolicited(streaming_chanend ciPodHID, unsigned cmdval, int rettransid, streaming chanend cAudioMixer[3], streaming chanend cLED)
{
  switch (cmdval)
  {
    case CMD_equalizerLingo_GetCurrentEQIndex:
    case CMD_equalizerLingo_SetCurrentEQIndex:
    case CMD_equalizerLingo_GetEQSettingCount:
    case CMD_equalizerLingo_GetEQIndexName:
      iPod_Equalizer_Rx(ciPodHID, cmdval, rettransid);
      break;
    default:
      // Unrecognised Unsolicited Command
#if 0
      vprintstrln("Unsupported IAP command");
      vprintintln(retVal);
      while (1);
#endif
      break;
  }
  return 0;
}

