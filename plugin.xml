<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>

   <extension
         id="application"
         point="org.eclipse.core.runtime.applications">
      <application>
         <run
               class="com.xmos.xta.rcp.Application">
         </run>
      </application>
   </extension>
   <extension
         point="org.eclipse.ui.perspectives">
      <perspective
            name="com.xmos.xta.rcp.XtaPerspective"
            class="com.xmos.xta.rcp.XtaPerspective"
            id="com.xmos.xta.rcp.XtaPerspective">
      </perspective>
   </extension>
   <extension
         point="org.eclipse.ui.editors">
      <editor
            class="com.xmos.xta.rcp.editors.Sources"
            default="false"
            id="com.xmos.xta.rcp.editors.Sources"
            name="Sources">
      </editor>
      <editor
            class="com.xmos.xta.rcp.editors.XtaEditor"
            default="false"
            id="com.xmos.xta.rcp.editors.XtaEditor"
            name="XtaEditor">
      </editor>
   </extension>
   <extension
         point="org.eclipse.ui.views">
      <view
            class="com.xmos.xta.rcp.views.TreeView"
            icon="icons/tree.png"
            id="com.xmos.xta.rcp.views.Tree"
            name="Tree"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.rcp.views.ConsoleView"
            icon="icons/console.png"
            id="com.xmos.xta.rcp.views.Console"
            name="Console"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.rcp.views.ErrorsView"
            icon="icons/errors.png"
            id="com.xmos.xta.rcp.views.Errors"
            name="Errors"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.rcp.views.FunctionView"
            icon="icons/function.png"
            id="com.xmos.xta.rcp.views.Function"
            name="Function"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.rcp.views.FlowView"
            icon="icons/flow.png"
            id="com.xmos.xta.rcp.views.Flow"
            name="Flow"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.rcp.views.StructureView"
            icon="icons/structure.png"
            id="com.xmos.xta.rcp.views.Structure"
            name="Structure"
            restorable="true">
      </view>
      <view
            class="com.xmos.xta.rcp.views.UnknownsView"
            icon="icons/unknowns.png"
            id="com.xmos.xta.rcp.views.Unknowns"
            name="Unknowns"
            restorable="true">
      </view>
   </extension>
  
   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="toolbar:com.xmos.xta.rcp.views.Tree">
         <command
               commandId="com.xmos.xta.rcp.tree.settings.command"
               icon="icons/settings.png"
               id="com.xmos.xta.rcp.tree.settings.command"
               label="Settings"
               style="push">
         </command>
         <command
               commandId="com.xmos.xta.rcp.tree.load.command"
               icon="icons/load.png"
               id="com.xmos.xta.rcp.tree.load.command"
               label="Load"
               style="push">
         </command>
         <command
               commandId="com.xmos.xta.rcp.tree.run.command"
               icon="icons/run.png"
               id="com.xmos.xta.rcp.tree.run.command"
               label="Run"
               style="push">
         </command>
      </menuContribution>
      <menuContribution
            locationURI="toolbar:com.xmos.xta.rcp.views.Function">
         <command
               commandId="com.xmos.xta.rcp.function.loops.command"
               icon="icons/loop.png"
               id="com.xmos.xta.rcp.function.loops.command"
               label="Show loops"
               style="push">
         </command>
      </menuContribution>
      <menuContribution
            locationURI="toolbar:com.xmos.xta.rcp.views.Structure">
         <command
               commandId="com.xmos.xta.rcp.structure.circle.command"
               icon="icons/loop.png"
               id="com.xmos.xta.rcp.structure.circle.command"
               label="Draw circle"
               style="push">
         </command>
         <command
               commandId="com.xmos.xta.rcp.structure.zoomin.command"
               icon="icons/zoomin.png"
               id="com.xmos.xta.rcp.structure.zoomin.command"
               label="Zoom In"
               style="push">
         </command>
         <command
               commandId="com.xmos.xta.rcp.structure.zoomout.command"
               icon="icons/zoomout.png"
               id="com.xmos.xta.rcp.structure.zoomout.command"
               label="Zoom Out"
               style="push">
         </command>
         <command
               commandId="com.xmos.xta.rcp.structure.zoomreset.command"
               icon="icons/zoomreset.png"
               id="com.xmos.xta.rcp.structure.zoomreset.command"
               label="Reset Zoom"
               style="push">
         </command>
      </menuContribution>
   </extension> <extension
         point="org.eclipse.ui.commands">
      <command
            defaultHandler="com.xmos.xta.rcp.handlers.TreeLoadHandler"
            id="com.xmos.xta.rcp.tree.load.command"
            name="com.xmos.xta.rcp.tree.load.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.rcp.handlers.TreeRunHandler"
            id="com.xmos.xta.rcp.tree.run.command"
            name="com.xmos.xta.rcp.tree.run.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.rcp.handlers.TreeSettingsHandler"
            id="com.xmos.xta.rcp.tree.settings.command"
            name="com.xmos.xta.rcp.tree.settings.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.rcp.handlers.FunctionLoopsHandler"
            id="com.xmos.xta.rcp.function.loops.command"
            name="com.xmos.xta.rcp.function.loops.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.rcp.handlers.StructureCircleHandler"
            id="com.xmos.xta.rcp.structure.circle.command"
            name="com.xmos.xta.rcp.structure.circle.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.rcp.handlers.StructureZoomInHandler"
            id="com.xmos.xta.rcp.structure.zoomin.command"
            name="com.xmos.xta.rcp.structure.zoomin.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.rcp.handlers.StructureZoomOutHandler"
            id="com.xmos.xta.rcp.structure.zoomout.command"
            name="com.xmos.xta.rcp.structure.zoomout.command">
      </command>
      <command
            defaultHandler="com.xmos.xta.rcp.handlers.StructureZoomResetHandler"
            id="com.xmos.xta.rcp.structure.zoomreset.command"
            name="com.xmos.xta.rcp.structure.zoomreset.command">
      </command>command>
   </extension>
   <extension
         point="org.eclipse.ui.editors.markerAnnotationSpecification">
      <specification
            annotationType="com.xmos.xta.rcp.highlight"
            colorPreferenceKey="errorIndicationColor"
            colorPreferenceValue="255,255,75"
            contributesToHeader="true"
            highlightPreferenceKey="errorIndicationHighlighting"
            highlightPreferenceValue="true"
            isGoToNextNavigationTarget="true"
            isGoToNextNavigationTargetKey="isErrorGoToNextNavigationTarget"
            isGoToPreviousNavigationTarget="true"
            isGoToPreviousNavigationTargetKey="isErrorGoToPreviousNavigationTarget"
            label="Highlight"
            overviewRulerPreferenceKey="errorIndicationInOverviewRuler"
            overviewRulerPreferenceValue="true"
            presentationLayer="6"
            showInNextPrevDropdownToolbarAction="true"
            showInNextPrevDropdownToolbarActionKey="showErrorInNextPrevDropdownToolbarAction"
            symbolicIcon="error"
            textPreferenceKey="errorIndication"
            textPreferenceValue="true"
            textStylePreferenceKey="errorTextStyle"
            textStylePreferenceValue="PROBLEM_UNDERLINE"
            verticalRulerPreferenceKey="errorIndicationInVerticalRuler"
            verticalRulerPreferenceValue="false">
      </specification>
      <specification
            annotationType="com.xmos.xta.rcp.unknown"
            colorPreferenceKey="errorIndicationColor"
            contributesToHeader="false"
            highlightPreferenceValue="false"
            includeOnPreferencePage="false"
            isGoToNextNavigationTarget="false"
            isGoToNextNavigationTargetKey="isErrorGoToNextNavigationTarget"
            isGoToPreviousNavigationTarget="false"
            isGoToPreviousNavigationTargetKey="isErrorGoToPreviousNavigationTarget"
            label="Unknown"
            overviewRulerPreferenceKey="errorIndicationInOverviewRuler"
            overviewRulerPreferenceValue="false"
            presentationLayer="6"
            showInNextPrevDropdownToolbarAction="false"
            showInNextPrevDropdownToolbarActionKey="showErrorInNextPrevDropdownToolbarAction"
            symbolicIcon="warning"
            textPreferenceKey="errorIndication"
            textPreferenceValue="false"
            textStylePreferenceValue="NONE"
            verticalRulerPreferenceKey="errorIndicationInVerticalRuler"
            verticalRulerPreferenceValue="true">
      </specification>
      <specification
            annotationType="com.xmos.xta.rcp.start"
            colorPreferenceKey="errorIndicationColor"
            contributesToHeader="false"
            highlightPreferenceValue="false"
            icon="icons/start.png"
            includeOnPreferencePage="false"
            isGoToNextNavigationTarget="false"
            isGoToNextNavigationTargetKey="isErrorGoToNextNavigationTarget"
            isGoToPreviousNavigationTarget="false"
            isGoToPreviousNavigationTargetKey="isErrorGoToPreviousNavigationTarget"
            label="Start"
            overviewRulerPreferenceKey="errorIndicationInOverviewRuler"
            overviewRulerPreferenceValue="false"
            presentationLayer="6"
            showInNextPrevDropdownToolbarAction="false"
            showInNextPrevDropdownToolbarActionKey="showErrorInNextPrevDropdownToolbarAction"
            symbolicIcon="warning"
            textPreferenceKey="errorIndication"
            textPreferenceValue="false"
            textStylePreferenceValue="NONE"
            verticalRulerPreferenceKey="errorIndicationInVerticalRuler"
            verticalRulerPreferenceValue="true">
      </specification>
      <specification
            annotationType="com.xmos.xta.rcp.stop"
            colorPreferenceKey="errorIndicationColor"
            contributesToHeader="false"
            highlightPreferenceValue="false"
            icon="icons/stop.png"
            includeOnPreferencePage="false"
            isGoToNextNavigationTarget="false"
            isGoToNextNavigationTargetKey="isErrorGoToNextNavigationTarget"
            isGoToPreviousNavigationTarget="false"
            isGoToPreviousNavigationTargetKey="isErrorGoToPreviousNavigationTarget"
            label="Stop"
            overviewRulerPreferenceKey="errorIndicationInOverviewRuler"
            overviewRulerPreferenceValue="false"
            presentationLayer="6"
            showInNextPrevDropdownToolbarAction="false"
            showInNextPrevDropdownToolbarActionKey="showErrorInNextPrevDropdownToolbarAction"
            symbolicIcon="warning"
            textPreferenceKey="errorIndication"
            textPreferenceValue="false"
            textStylePreferenceValue="NONE"
            verticalRulerPreferenceKey="errorIndicationInVerticalRuler"
            verticalRulerPreferenceValue="true">
      </specification>
   </extension>
 
   <extension
         point="org.eclipse.ui.editors.annotationTypes">
      <type
         name="com.xmos.xta.rcp.highlight"
         super="org.eclipse.ui.workbench.texteditor.error"
         markerType=""
         markerSeverity="2">
      </type>
      <type
            name="com.xmos.xta.rcp.unknown"
            super="org.eclipse.ui.workbench.texteditor.info">
      </type>
      <type
            name="com.xmos.xta.rcp.start"
            super="org.eclipse.ui.workbench.texteditor.info">
      </type>
      <type
            name="com.xmos.xta.rcp.stop"
            super="org.eclipse.ui.workbench.texteditor.info">
      </type>
   </extension>
   <extension
         id="product"
         point="org.eclipse.core.runtime.products">
      <product
            application="tools_xta.application"
            name="tools_xta">
         <property
               name="appName"
               value="tools_xta">
         </property>
      </product>
   </extension>
   <extension
         id="product1"
         point="org.eclipse.core.runtime.products">
      <product
            application="tools_xta.application"
            name="Xmos Timing Anaylsis">
         <property
               name="appName"
               value="Xmos Timing Anaylsis">
         </property>
      </product>
   </extension>
  
</plugin>
