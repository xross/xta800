# This is the data receive loop path
add exclusion packet_start
add exclusion eop_detected
analyse path receive_loop receive_loop
set required - 320 ns

# This is the inter-frame gap path
remove exclusion *
add exclusion do_loop
add exclusion error_overflow 
add exclusion error_crc 
add exclusion error_len 
add exclusion error_nibble
analyse path eop_detected packet_start
set required - 1520 ns

print summary
exit
