void f\(\) {
    int res = 0;

    for \(int i = 0; i < 10; \+\+i\) {
        #pragma xta label "outer"
        for \(int j = 0; j < 3; \+\+j\) {
            #pragma xta label "inner"
            res \+= j;
        }
        res \+= i;
    }

    for \(int i = 0; i < 10; \+\+i\) {
        for \(int j = 0; j < 3; \+\+j\) {
            res \+= j;
        }
        res \+= i;
    }
}

